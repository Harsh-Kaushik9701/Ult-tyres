# Copy to .env.local and fill in. Never commit real values.

# --- Interim staging protection (until real dealer/staff login is built) ---
# /admin is locked to these credentials (HTTP Basic auth).
ADMIN_USER=
ADMIN_PASSWORD=
# /portal accepts these credentials (and the admin pair).
PORTAL_USER=
PORTAL_PASSWORD=
# If a pair is empty, that area returns 503 in production and stays open in `npm run dev`.

# --- Demo mode ---
# true = show the persona switcher in the top ribbon and one-click demo logins.
# Leave unset (false) for any deployment the client or public can see.
NEXT_PUBLIC_DEMO_MODE=false

